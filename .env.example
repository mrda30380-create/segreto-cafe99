NODE_ENV=production
PORT=3000
# ضع نفس كلمة مرور لوحة الإدارة التي تستخدمها حاليًا هنا محليًا / في Render Environment Variables فقط.
# لا تضعها داخل index.html أو admin.html.
ADMIN_PASSWORD=YOUR_EXISTING_ADMIN_PASSWORD

# Render سيعطيك DATABASE_URL تلقائيًا عند ربط PostgreSQL بالخدمة.
DATABASE_URL=

# اتركها فارغة حتى تربط بوابة الدفع لاحقًا.
PAYMENT_CHECKOUT_URL=
